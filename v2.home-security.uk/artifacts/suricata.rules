# Suricata Rules - Production Rules from Secureblue Host
# Deployed to /var/lib/suricata/rules/suricata.rules by GitHub Actions
# Last updated: 2026-10-13

# ============================================
# EXISTING PRODUCTION RULES
# (Copy your actual rules from /etc/suricata/rules/suricata.rules on the host)
# ============================================

# Example: SSH brute force detection
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"SSH brute force attempt detected"; flow:to_server,established; detection_filter:track by_src, count 5, seconds 60; classtype:attempted-admin; sid:1000001; rev:1;)

# Example: HTTP suspicious User-Agent
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Suspicious User-Agent detected"; flow:to_server,established; content:"sqlmap"; http_header; classtype:attempted-recon; sid:1000002; rev:1;)

# Example: DNS tunneling detection
alert dns $EXTERNAL_NET any -> $HOME_NET any (msg:"Possible DNS tunneling"; dns.query; content:!"."; depth:gt 50; classtype:trojan-activity; sid:1000003; rev:1;)

